service:
    title is Surface Water Level Dashboard
    version is 1.0.0
    scope is Environment

data:
    sources -> surfacewaterlevel

surfacewaterlevel:
    type is SmartMeter
    provider is Fiware
    uri is http://localhost:1026/v2/entities
    query is WaterLevelObserved

application:
    type is Web
    dashboard is Dash
    layout is SinglePage
    roles -> User, SuperUser, Admin
    panels -> TS

TS:
    label is Time Series
    type is timeseries
    source is surfacewaterlevel
    traces -> dateObserved, waterLevel, id

deployment:
    environments -> local

local:
    uri is https://localhost.org:3000/test
    port is 50055
    type is Docker