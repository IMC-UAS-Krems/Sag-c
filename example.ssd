service:
    title is Grafana dashboard
    version is 1.0.0
    scope is Environment
    test:
        one is one
        two is two

data:
    sources -> first

first:
    type is SmartMeter
    provider is Fiware
    uri is https://data.iiss.at/dataskop/fiwarenosec/v2/entities
    query is AirQualityObserved

application:
    type is Web
    layout is SinglePage
    roles -> User, SuperUser, Admin
    panels -> Map, Pie, XY, TS, PluginGMap, Bar

Map:
    label is map
    type is geomap
    source is first
    data -> location, stationName, O3, NO2, SO2, address

Pie:
    label is pie
    type is pie_chart
    source is first
    traces -> NOx, O3, NO2, SO2
    pie_chart_type is pie

XY:
    label is xy
    type is xy_chart
    source is first
    traces -> dateObserved, NOx, O3, NO2, SO2

TS:
    label is ts
    type is timeseries
    source is first
    traces -> dateObserved, NOx, O3, NO2, SO2

PluginGMap:
    label is grafana_map
    type is grafana-map
    source is first
    data -> location, stationName, O3, NO2, SO2, address

Bar:
    label is bar
    type is bar_chart
    source is first
    traces -> dateObserved, NOx, O3, NO2, SO2

deployment:
    environments -> local

local:
    uri is https://localhost.org:3000/test
    port is 50055
    type is Docker
